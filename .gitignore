# OS
.DS_Store
Thumbs.db

# Editor
.idea/
.vscode/
*.swp
*.swo
*~

# Env / secrets — never commit
.env
.env.local
**/key.properties
*.keystore
*.jks

# Node (root and per-package)
node_modules/
npm-debug.log*
.npm/

# Docker / build artifacts (per-package .gitignore covers the rest)

# mkdocs output
site/

# local mkdocs build venv
.venv-docs/

# Local-only agent state (per-machine, never in repo)
.hermes/state.db
.hermes/state.db-*
.hermes/.env
.hermes/auth.json
.hermes/sessions/
.hermes/logs/
.hermes/cache/
# Skills Hub state (per-machine): lock, quarantine, audit log, index cache.
# The skill CONTENT (SKILL.md + references/) IS tracked; the hub state is not.
.hermes/skills/.hub/

# Per-session prompt snapshot — regenerated each session, ~54 KB.
# Cached by Hermes on every chat start; safe to ignore at repo root.
.skills_prompt_snapshot.json

# Local plans, plugins and skills ARE tracked in this repo (referenced by
# docs/specs/* and AGENTS.md). Add the above machine-state paths only.
# If you add a new top-level agent artifact, decide per-path: is it
# shared (this repo, this team) or per-machine (gitignore)?
#
# This is a deliberate divergence from the upstream Hermes .gitignore,
# which blanket-ignores .hermes/. Reason: docs/specs/add-pending-imports-tile
# references .hermes/plans/<file> as the plan maestro for that feature.
# Plans here are team artifacts, not per-machine state.

